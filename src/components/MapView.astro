---
import type { Pin } from '../lib/data';

interface Props {
  pins: Pin[];
  height?: number;
  label?: string;
}
const { pins, height = 380, label = 'Map of filming locations' } = Astro.props;
---

{
  pins.length > 0 ? (
    <div class="map" data-pins={JSON.stringify(pins)} style={`height:${height}px`} role="region" aria-label={label} />
  ) : (
    <p class="muted">No coordinates yet for these locations.</p>
  )
}

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface Pin {
    id: string;
    name: string;
    lat: number;
    lng: number;
    count: number;
    href: string;
  }

  const escape = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const icon = L.divIcon({ className: 'pin', html: '✦', iconSize: [20, 20], iconAnchor: [10, 10], popupAnchor: [0, -10] });

  for (const el of document.querySelectorAll<HTMLElement>('.map[data-pins]')) {
    const pins: Pin[] = JSON.parse(el.dataset.pins!);
    const map = L.map(el, { scrollWheelZoom: false, worldCopyJump: true });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    const markers = pins.map((p) =>
      L.marker([p.lat, p.lng], { icon, title: p.name, alt: p.name })
        .bindPopup(`<a href="${p.href}"><b>${escape(p.name)}</b></a><br>${p.count} video${p.count === 1 ? '' : 's'}`)
        .addTo(map),
    );
    // Frame the main cluster (most spots are in Korea); far-away spots stay reachable by panning.
    const median = (xs: number[]) => [...xs].sort((a, b) => a - b)[Math.floor(xs.length / 2)];
    const mid = { lat: median(pins.map((p) => p.lat)), lng: median(pins.map((p) => p.lng)) };
    const cluster = markers.filter((_, i) => Math.abs(pins[i].lat - mid.lat) < 6 && Math.abs(pins[i].lng - mid.lng) < 6);
    const framed = cluster.length >= pins.length / 2 ? cluster : markers;
    if (framed.length === 1) map.setView(framed[0].getLatLng(), 15);
    else map.fitBounds(L.featureGroup(framed).getBounds(), { padding: [24, 24], maxZoom: 15 });

    // Scroll-zoom only after the map has been clicked, so the page still scrolls normally.
    map.once('focus click', () => map.scrollWheelZoom.enable());
  }
</script>
