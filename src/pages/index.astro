---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import MapView from '../components/MapView.astro';
import VideoCard from '../components/VideoCard.astro';
import LocationCard from '../components/LocationCard.astro';
import { db, href, pinsFor, stableShuffle, url } from '../lib/data';

const data = await db();
const count = (id: string) => data.atLocation(id).length;
const pins = pinsFor(data.locations, (l) => data.videoCount(l.id));
const busiest = data.locations
  .filter((l) => l.data.status === 'identified')
  .sort((a, b) => count(b.id) - count(a.id))
  .slice(0, 8);
const picks = stableShuffle(data.videos.filter((v) => v.data.platform === 'youtube'), 'home').slice(0, 8);
const unknown = data.locations.filter((l) => l.data.status === 'unknown').length;
const topArtists = [...data.artists].sort((a, b) => data.byArtist(b.id).length - data.byArtist(a.id).length).slice(0, 14);
---

<Base>
  <div class="split">
    <Window title="Welcome!!" heading="h1">
      <div class="welcome">
        <p>
          Hi! This is a fan-made list of the places where K-pop music videos were filmed: studios, rooftops, parking towers,
          abandoned parks, gas stations…
        </p>
        <p>
          Each entry has the screenshot where the place shows up. Look things up by <a href={url('artists/')}>artist</a>,{' '}
          by <a href={url('locations/')}>location</a>, or on the <a href={url('map/')}>map</a>.
        </p>
        <p class="welcome-note">
          <b>{unknown} spots are still unidentified.</b> They're marked <span class="badge" data-kind="unknown">???</span> — if you
          recognise one, a suggestion form is coming soon.
        </p>
      </div>
    </Window>

    <Window title="Tags" tone="chrome">
      <ul class="chips">
        {data.tags.map((t) => <li><a class="chip" href={href.tag(t.slug)}>{t.name}<b>{t.count}</b></a></li>)}
      </ul>
    </Window>
  </div>

  <Window title="World map" flush>
    <MapView pins={pins} height={380} />
  </Window>

  <Window title="Busiest spots" tone="pink">
    <ul class="cards">{busiest.map((l) => <li><LocationCard location={l} /></li>)}</ul>
    <p class="more"><a href={url('locations/')}>ALL LOCATIONS ▸</a></p>
  </Window>

  <div class="split">
    <Window title="Random picks">
      <ul class="cards" id="picks" data-src={url('picks.json')}>{picks.map((v) => <li><VideoCard video={v} /></li>)}</ul>
      <p class="more">
        <button class="btn" type="button" id="reshuffle" hidden>↻ SHUFFLE</button>
        <a href={url('videos/')}>ALL VIDEOS ▸</a>
      </p>
    </Window>
    <Window title="Most seen artists" tone="chrome">
      <ol class="dotlist">
        {
          topArtists.map((a) => (
            <li>
              <a href={href.artist(a.id)}>{a.data.name}</a>
              {a.data.name_ko && <span class="muted" lang="ko"> {a.data.name_ko}</span>}
              <span class="muted"> · {data.byArtist(a.id).length}</span>
            </li>
          ))
        }
      </ol>
      <p class="more"><a href={url('artists/')}>ALL ARTISTS ▸</a></p>
    </Window>
  </div>
</Base>

<script>
  // "Random picks" are built as a fixed set; replace them with a fresh random draw on every visit.
  interface Card { href: string; img: string; kind: string; badge: string; label: string; ko: string; meta: string }
  const list = document.querySelector<HTMLUListElement>('#picks');
  const button = document.querySelector<HTMLButtonElement>('#reshuffle');

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, string> = {}, ...kids: (Node | string)[]) => {
    const node = document.createElement(tag);
    for (const [k, v] of Object.entries(props)) node.setAttribute(k, v);
    node.append(...kids);
    return node;
  };
  // Same markup as VideoCard.astro.
  const card = (c: Card) => {
    const img = el('img', { src: c.img, alt: '', loading: 'lazy', decoding: 'async', width: '480', height: '270' });
    const title = el('p', { class: 'card-title' }, c.label);
    if (c.ko) title.append(el('span', { class: 'muted', lang: 'ko' }, ` ${c.ko}`));
    return el('li', {}, el('a', { class: 'card', href: c.href },
      el('div', { class: 'card-img' }, img, el('span', { class: 'badge', 'data-kind': c.kind }, c.badge)),
      title,
      el('p', { class: 'card-meta' }, c.meta),
    ));
  };
  const draw = (cards: Card[], n: number) => {
    const pool = [...cards];
    for (let i = 0; i < Math.min(n, pool.length); i++) {
      const j = i + Math.floor(Math.random() * (pool.length - i));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    return pool.slice(0, n);
  };

  if (list && button) {
    const n = list.children.length;
    fetch(list.dataset.src!)
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then((cards: Card[]) => {
        const shuffle = () => list.replaceChildren(...draw(cards, n).map(card));
        shuffle();
        button.hidden = false;
        button.addEventListener('click', shuffle);
      })
      .catch(() => {}); // keep the built-in picks
  }
</script>
