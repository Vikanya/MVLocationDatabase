---
/**
 * The breadcrumb above a page's title: its section, then the pages it sits under, each a link back up
 * ("LOCATIONS › KINDS OF PLACE" on a kind of place, "LOCATIONS › COLUMBUS STUDIO" on one of its spaces).
 * Plain text on the section's own page. `trail` adds parents after the section (detail pages); the slot
 * goes at the end (a video's type badge).
 */
import { url } from '../lib/data';
import { pagePath, where } from '../lib/nav';

interface Props {
  trail?: { label: string; href: string }[];
}
const path = pagePath(Astro.url);
const { section, sub } = where(path);
const links = [
  ...[section, sub].filter((x) => x && x.path !== path).map((x) => ({ label: x!.label.toUpperCase(), href: url(x!.path) })),
  ...(Astro.props.trail ?? []),
];
const extra = Astro.slots.has('default');
---

<nav class="kicker" aria-label="Breadcrumb">
  {
    links.length === 0
      ? section?.label.toUpperCase()
      : links.map((x, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> › </span>}
            <a href={x.href}>{x.label}</a>
          </>
        ))
  }
  {extra && <span aria-hidden="true"> › </span>}
  <slot />
</nav>
