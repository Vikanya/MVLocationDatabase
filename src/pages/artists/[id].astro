---
import Base from '../../layouts/Base.astro';
import Window from '../../components/Window.astro';
import MapView from '../../components/MapView.astro';
import VideoCard from '../../components/VideoCard.astro';
import { db, href, pinsFor, type Artist, type Location } from '../../lib/data';

export async function getStaticPaths() {
  const data = await db();
  return data.artists.map((artist) => ({ params: { id: artist.id }, props: { artist } }));
}

const { artist } = Astro.props as { artist: Artist };
const data = await db();
const own = data.byArtist(artist.id);
const groups = data.groupsOf(artist.id);
const members = data.membersOf(artist.id);
const directMembers = data.directMembers(artist.id);
// Videos by members & units, grouped by who made them (each video once, even if several members are tagged).
const seen = new Set(own.map((v) => v.id));
const memberVideos = members
  .map((m) => ({ member: m, videos: data.byArtist(m.id).filter((v) => !seen.has(v.id) && (seen.add(v.id), true)) }))
  .filter((m) => m.videos.length > 0);
const allVideos = [...own, ...memberVideos.flatMap((m) => m.videos)];

const visits = new Map<string, { location: Location; videos: number }>();
for (const v of allVideos) {
  for (const a of data.ofVideo(v.id)) {
    const entry = visits.get(a.location.id) ?? { location: a.location, videos: 0 };
    entry.videos += 1;
    visits.set(a.location.id, entry);
  }
}
const places = [...visits.values()].sort((a, b) => b.videos - a.videos || a.location.data.name.localeCompare(b.location.data.name));
const pins = pinsFor(places.map((p) => p.location), (l) => visits.get(l.id)!.videos);
const { name, name_ko } = artist.data;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---

<Base title={name} description={`Filming locations of ${name}'s music videos.`} searchable>
  <header class="page-head">
    <span class="kicker">ARTIST</span>
    <h1>{name}{name_ko && <span class="muted" lang="ko"> {name_ko}</span>}</h1>
    <p class="sub">
      {plural(allVideos.length, 'video')} · {plural(places.length, 'location')}
      {memberVideos.length > 0 && ` · includes ${plural(memberVideos.length, 'member / unit')}`}
    </p>
    {
      groups.length > 0 && (
        <p class="sub">
          Part of{' '}
          {groups.map((g, i) => (
            <>
              {i > 0 && ', '}
              <a href={href.artist(g.id)}>{g.data.name}</a>
            </>
          ))}
        </p>
      )
    }
  </header>

  {
    directMembers.length > 0 && (
      <Window title="Members & units" tone="chrome">
        <ul class="chips">
          {directMembers.map((m) => (
            <li>
              <a class="chip" href={href.artist(m.id)}>
                {m.data.name}
                <b>{data.byArtist(m.id).length}</b>
              </a>
            </li>
          ))}
        </ul>
      </Window>
    )
  }

  {
    own.length > 0 && (
      <Window title={memberVideos.length ? `Videos as ${name}` : 'Videos'}>
        <ul class="cards">{own.map((v) => <li><VideoCard video={v} /></li>)}</ul>
      </Window>
    )
  }

  {
    memberVideos.map(({ member, videos }) => (
      <Window title={`Videos by ${member.data.name}`} tone="pink">
        <p class="more" style="margin:0 0 10px;text-align:left">
          <a href={href.artist(member.id)}>{member.data.name.toUpperCase()} PAGE ▸</a>
        </p>
        <ul class="cards">{videos.map((v) => <li><VideoCard video={v} /></li>)}</ul>
      </Window>
    ))
  }

  <div class="split">
    <Window title="Where they filmed" flush>
      <MapView pins={pins} height={320} label={`Map of ${name}'s filming locations`} />
    </Window>
    <Window title="Locations" tone="chrome">
      <ul class="dotlist">
        {
          places.map((p) => (
            <li>
              <a href={href.location(p.location.id)}>{p.location.data.name}</a>
              {p.location.data.status === 'unknown' && <span class="badge" data-kind="unknown">???</span>}
              <span class="muted"> · {p.videos}</span>
            </li>
          ))
        }
      </ul>
    </Window>
  </div>
</Base>
