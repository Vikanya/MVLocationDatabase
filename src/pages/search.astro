---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import { url } from '../lib/data';
---

<Base title="Search" description="Search artists, videos and locations.">
  <header class="page-head">
    <span class="kicker">SEARCH</span>
    <h1>Search</h1>
    <p class="sub">Artists, song titles, places, addresses — in English or Korean.</p>
  </header>
  <Window title="Search the database">
    <div id="search" data-bundle={url('pagefind/')}></div>
    <noscript><p>Search needs JavaScript. You can still browse the <a href={url('artists/')}>artists</a> and <a href={url('locations/')}>locations</a> lists.</p></noscript>
  </Window>
</Base>

<script>
  // Pagefind builds its index after the site (npm run build); in `astro dev` it doesn't exist yet.
  const root = document.getElementById('search')!;
  const bundle = root.dataset.bundle!;
  const css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = `${bundle}pagefind-ui.css`;
  document.head.append(css);
  const script = document.createElement('script');
  script.src = `${bundle}pagefind-ui.js`;
  script.onload = () => {
    // @ts-expect-error PagefindUI is a global from the script above
    const ui = new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false });
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  };
  script.onerror = () => {
    root.innerHTML = '<p class="muted">The search index is built with the site (<code>npm run build</code>) — it isn’t available in dev mode.</p>';
  };
  document.body.append(script);
</script>

<style is:global>
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--electric);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: #fff;
    --pagefind-ui-border: var(--ink);
    --pagefind-ui-tag: var(--lime);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--f-body);
  }
  #search .pagefind-ui__result-link {
    color: var(--electric);
  }
  #search .pagefind-ui__search-input {
    box-shadow: inset 1px 1px 0 var(--chrome-lo);
  }
</style>
