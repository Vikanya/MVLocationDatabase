---
import Base from '../../layouts/Base.astro';
import Window from '../../components/Window.astro';
import MapView from '../../components/MapView.astro';
import Player from '../../components/Player.astro';
import Shots from '../../components/Shots.astro';
import VideoCard from '../../components/VideoCard.astro';
import { db, href, pinsFor, stableShuffle, TYPE_LABEL, videoLabel, type Video } from '../../lib/data';

export async function getStaticPaths() {
  const data = await db();
  return data.videos.map((video) => ({ params: { id: video.id }, props: { video } }));
}

const { video } = Astro.props as { video: Video };
const data = await db();
const artists = data.videoArtists(video);
const appearances = data.ofVideo(video.id);
const pins = pinsFor(appearances.map((a) => a.location), () => 1);
const kind = video.data.type ?? 'other';
const who = artists.map((a) => a.data.name).join(', ');
const related = data.relatedTo(video.id);

// Where to go next: other videos at each of its places, then more by its artists. Each video is shown once.
const STRIP = 8;
const shown = new Set([video.id, ...related.map((v) => v.id)]);
const take = (videos: Video[]) => {
  const picked = stableShuffle(videos.filter((v) => !shown.has(v.id)), video.id).slice(0, STRIP);
  picked.forEach((v) => shown.add(v.id));
  return picked;
};
const alsoHere = appearances
  .map((a) => {
    const here = data.atLocation(a.location.id);
    const cards = take(here.map((b) => b.video)).map((v) => ({ video: v, image: here.find((b) => b.video.id === v.id)?.shots[0]?.image }));
    return { location: a.location, total: here.length, cards };
  })
  .filter((s) => s.cards.length > 0);
const moreBy = artists
  .map((a) => {
    let cards = take(data.byArtist(a.id));
    let who = a;
    const group = data.groupsOf(a.id)[0];
    if (cards.length === 0 && group) {
      cards = take(data.withMembers(group.id));
      who = group;
    }
    return { artist: who, cards };
  })
  .filter((m) => m.cards.length > 0);
---

<Base
  title={`${videoLabel(video)}${who ? ` — ${who}` : ''}`}
  description={`Where "${video.data.title}" was filmed: ${appearances.map((a) => a.location.data.name).join(', ')}.`}
  searchable
>
  <header class="page-head">
    <span class="kicker"><span class="badge" data-kind={kind}>{TYPE_LABEL[kind]}</span></span>
    <h1>{video.data.title}</h1>
    {
      (video.data.songs ?? []).length > 0 && (
        <p class="sub">
          {video.data.songs!.map((s, i) => (
            <>
              {i > 0 && <span class="muted"> + </span>}
              ♪ {s.title && <b>{s.title}</b>}
              {s.title && s.title_ko && ' · '}
              {s.title_ko && <span lang="ko">{s.title_ko}</span>}
            </>
          ))}
        </p>
      )
    }
    <p class="sub">
      {
        artists.length > 0
          ? artists.map((a, i) => (
              <>
                {i > 0 && ', '}
                <a href={href.artist(a.id)}>{a.data.name}</a>
                {data.groupsOf(a.id)[0] && (
                  <span class="muted">
                    {' '}(<a href={href.artist(data.groupsOf(a.id)[0].id)}>{data.groupsOf(a.id)[0].data.name}</a>)
                  </span>
                )}
              </>
            ))
          : video.data.channel
      }
      {video.data.channel && artists.length > 0 && <span class="muted"> · channel: {video.data.channel}</span>}
    </p>
    {
      video.data.published && (
        <p class="sub">
          Published <a href={href.year(video.data.published.slice(0, 4))}>{video.data.published}</a>
        </p>
      )
    }
  </header>

  <div class="split">
    <Window title="Watch">
      <Player video={video} />
    </Window>
    <Window title={`Filmed at ${appearances.length} place${appearances.length === 1 ? '' : 's'}`} tone="chrome" flush>
      <MapView pins={pins} height={260} label="Map of this video's filming locations" />
    </Window>
  </div>

  <Window title="Filming locations" tone="pink">
    <div data-lightbox-group>
    {
      appearances.map((a) => (
        <article class="appearance">
          <div class="appearance-head">
            <h3>
              <a href={href.location(a.location.id)}>{a.location.data.name}</a>
            </h3>
            {a.location.data.status === 'unknown' && <span class="badge" data-kind="unknown">??? NOT IDENTIFIED YET</span>}
            {a.confidence === 'unsure' && <span class="badge" data-kind="unsure">NOT SURE</span>}
            {a.location.data.address && <span class="muted">{a.location.data.address}</span>}
          </div>
          {a.notes && <p class="muted">{a.notes}</p>}
          {a.shots.length > 0 ? (
            <Shots
              shots={a.shots.map((s) => ({
                ...s,
                video: { label: videoLabel(video) },
                location: { name: a.location.data.name, href: href.location(a.location.id) },
              }))}
              context={`${videoLabel(video)} at ${a.location.data.name}`}
            />
          ) : (
            <p class="muted">No screenshot yet.</p>
          )}
        </article>
      ))
    }
    </div>
  </Window>

  {
    related.length > 0 && (
      <Window title="Filmed together with" tone="chrome">
        <ul class="cards">{related.map((v) => <li><VideoCard video={v} /></li>)}</ul>
      </Window>
    )
  }

  {
    alsoHere.map((s) => (
      <Window title={`Also filmed at ${s.location.data.name}`}>
        <ul class="cards">{s.cards.map((c) => <li><VideoCard video={c.video} image={c.image} /></li>)}</ul>
        {s.total > STRIP + 1 && (
          <p class="more"><a href={href.location(s.location.id)}>ALL {s.total} ▸</a></p>
        )}
      </Window>
    ))
  }

  {
    moreBy.map((m) => (
      <Window title={`More by ${m.artist.data.name}`} tone="chrome">
        <ul class="cards">{m.cards.map((v) => <li><VideoCard video={v} /></li>)}</ul>
        <p class="more"><a href={href.artist(m.artist.id)}>{m.artist.data.name.toUpperCase()} PAGE ▸</a></p>
      </Window>
    ))
  }
</Base>
