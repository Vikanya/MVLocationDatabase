---
import { media, type Shot } from '../lib/data';

interface Props {
  shots: Shot[];
  /** Caption shown under every screenshot. */
  caption?: string;
  /** Extra context for the full-size view only (e.g. "UN-NORMAL at Ametage Studio"). */
  context?: string;
}
const { shots, caption, context } = Astro.props;
---

<ul class="shots">
  {
    shots.map((shot) => (
      <li data-set={shot.set?.id ?? ''}>
        <figure class="shot">
          <a
            href={media.full(shot.image)}
            data-lightbox
            data-caption={[context ?? caption, shot.set?.name].filter(Boolean).join(' · ')}
            data-video-label={shot.video?.label}
            data-video-href={shot.video?.href}
            data-location-label={shot.location?.name}
            data-location-href={shot.location?.href}
            data-set-name={shot.set?.name}
          >
            <img src={media.thumb(shot.image)} alt={caption ? `Screenshot: ${caption}` : 'Screenshot'} loading="lazy" decoding="async" width="480" height="270" />
          </a>
          {(caption || shot.set) && (
            <figcaption>
              <span>{caption}</span>
              {shot.set && <span class="set-label">{shot.set.name}</span>}
            </figcaption>
          )}
        </figure>
      </li>
    ))
  }
</ul>

<script>
  import '../scripts/lightbox';
</script>
