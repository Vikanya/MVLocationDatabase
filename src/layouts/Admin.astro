---
// Frame for the admin helper pages (quick add, to-do): the site's look, a small menu instead of the site's.
import '../styles/global.css';
import '../styles/admin.css';
import ThemeInit from '../components/ThemeInit.astro';
import { url } from '../lib/data';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { label: 'QUICK ADD', path: '/admin/add/' },
  { label: 'TO-DO', path: '/admin/todo/' },
  { label: 'ADMIN', path: '/admin/' },
  { label: 'SITE', path: '/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <ThemeInit />
    <title>{title} · Admin · MV Location DB</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Michroma&family=Nanum+Gothic:wght@400;700;800&family=Silkscreen&display=swap"
    />
  </head>
  <body>
    <div class="desktop admin">
      <header class="masthead admin-head">
        <a class="wordmark" href={url('admin/')}>
          <span class="wordmark-main">MV Location <span class="wordmark-star">✦</span> DB</span>
          <span class="wordmark-sub">ADMIN · {title.toUpperCase()}</span>
        </a>
        <nav class="admin-nav" aria-label="Admin">
          {
            nav.map((item) => (
              <a class="btn" href={url(item.path)} aria-current={path === item.path ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <button class="btn theme-toggle" type="button" id="theme-toggle">
            <span class="theme-dark">☾ DARK</span><span class="theme-light">☀ LIGHT</span>
          </button>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
    </div>
    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
